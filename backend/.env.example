# Environment Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Clinical EMR Generative AI Platform"
API_V1_STR="/api/v1"

# Security & Audit
SECRET_KEY=change-this-in-production-to-a-secure-256-bit-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH="logs/audit.log"
PHI_MASKING_ENABLED=true

# CORS Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Generative AI & Knowledge Base
GENAI_PROVIDER=mock
GENAI_MODEL_NAME=gemini-1.5-pro
VECTOR_DB_URL=postgresql://postgres:postgres@localhost:5432/clinical_vector_db
